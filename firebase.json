{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "predeploy": [
      "node scripts/check-deploy-alignment.js",
      "node scripts/check-version-ahead.js",
      "node scripts/check-release-notes.js",
      "npm test",
      "npm run prerender"
    ],
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "functions/**",
      "extensions/**",
      ".git/**",
      ".claude/**",
      "*.backup",
      "outputs/**",
      ".deploy-alignment.json"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "node scripts/check-deploy-alignment.js"
      ]
    }
  ],
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.2.7"
  }
}
