<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ScoreplaceWearTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- ⛔ TEMA DE ABERTURA — o que o Play exigiu na recusa da 109.
         A activity nasce com ELE (declarado no manifesto) e troca para o
         `ScoreplaceWearTheme` no `onCreate`, ANTES do `setContentView`. É o padrão
         documentado de "branded launch" e funciona desde a API 30. -->
    <style name="ScoreplaceWearSplash" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_wear</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
