<?xml version="1.0" encoding="utf-8"?>
<app.scoreplace.wear.WatchViewport
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/watch_viewport"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">
    <ScrollView style="@style/WearPage" android:id="@+id/score_page" android:visibility="gone">
        <LinearLayout style="@style/WearColumn">
            <TextView
                style="@style/WearCaption"
                android:id="@+id/hr_pill"
                android:visibility="gone"
                android:layout_width="wrap_content" />
            <LinearLayout style="@style/WearRow">
                <TextView style="@style/WearScore" android:id="@+id/sets_arc_left" />
                <TextView
                    style="@style/WearCaption"
                    android:text="SETS"
                    android:layout_width="wrap_content" />
                <TextView style="@style/WearScore" android:id="@+id/sets_arc_right" />
            </LinearLayout>
            <LinearLayout style="@style/WearRow">
                <TextView style="@style/WearScore" android:id="@+id/games_left" />
                <TextView
                    style="@style/WearCaption"
                    android:id="@+id/games_label"
                    android:text="GAMES"
                    android:layout_width="wrap_content" />
                <TextView style="@style/WearScore" android:id="@+id/games_right" />
            </LinearLayout>
            <LinearLayout style="@style/WearRow" android:baselineAligned="false" android:gravity="top">
                <LinearLayout
                    style="@style/WearColumn"
                    android:id="@+id/half_left"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:focusable="true">
                    <TextView
                        style="@style/WearText"
                        android:id="@+id/point_left"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <TextView style="@style/WearText" android:id="@+id/name_l1" android:textSize="14sp" />
                    <TextView style="@style/WearText" android:id="@+id/name_l2" android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout
                    style="@style/WearColumn"
                    android:id="@+id/half_right"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:focusable="true">
                    <TextView
                        style="@style/WearText"
                        android:id="@+id/point_right"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                    <TextView style="@style/WearText" android:id="@+id/name_r1" android:textSize="14sp" />
                    <TextView style="@style/WearText" android:id="@+id/name_r2" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                style="@style/WearAction"
                android:id="@+id/btn_undo"
                android:text="↺ Desfazer"
                android:backgroundTint="@color/undo_bg"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
    <ScrollView style="@style/WearPage" android:id="@+id/winner_overlay" android:visibility="gone">
        <LinearLayout style="@style/WearColumn">
            <TextView style="@style/WearCaption" android:id="@+id/winner_arc_sport" />
            <TextView style="@style/WearCaption" android:id="@+id/winner_label" />
            <TextView
                style="@style/WearText"
                android:id="@+id/winner_names"
                android:textColor="@color/team_blue"
                android:textSize="19sp"
                android:textStyle="bold" />
            <LinearLayout style="@style/WearRow">
                <TextView style="@style/WearScore" android:id="@+id/winner_score_l" />
                <TextView style="@style/WearCaption" android:text="–" android:layout_width="wrap_content" />
                <TextView style="@style/WearScore" android:id="@+id/winner_score_r" />
            </LinearLayout>
            <TextView style="@style/WearText" android:id="@+id/rr_series_label" android:visibility="gone" />
            <TextView
                style="@style/WearAction"
                android:id="@+id/btn_rr_next"
                android:text="Próximo jogo"
                android:backgroundTint="@color/rr_amber_dark"
                android:textColor="#FFFFFF"
                android:visibility="gone" />
            <TextView
                style="@style/WearText"
                android:id="@+id/rr_final_title"
                android:text="👑 Rei/Rainha"
                android:visibility="gone" />
            <LinearLayout
                style="@style/WearColumn"
                android:id="@+id/rr_standings"
                android:visibility="gone" />
            <TextView
                style="@style/WearCaption"
                android:id="@+id/winner_waiting"
                android:text="Aguardando o celular…"
                android:visibility="gone" />
            <LinearLayout
                style="@style/WearColumn"
                android:id="@+id/replay_controls"
                android:visibility="gone">
                <LinearLayout
                    style="@style/WearColumn"
                    android:id="@+id/reshuffle_row"
                    android:visibility="gone">
                    <LinearLayout style="@style/WearRow">
                        <TextView
                            style="@style/WearText"
                            android:id="@+id/reshuffle_label"
                            android:text="🎲"
                            android:layout_width="wrap_content"
                            android:textSize="18sp"
                            android:importantForAccessibility="no" />
                        <Switch
                            android:id="@+id/reshuffle_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:contentDescription="Sortear duplas" />
                    </LinearLayout>
                    <LinearLayout style="@style/WearRow">
                        <TextView
                            style="@style/WearText"
                            android:id="@+id/rr_icon"
                            android:text="👑"
                            android:layout_width="wrap_content"
                            android:textSize="18sp"
                            android:importantForAccessibility="no" />
                        <Switch
                            android:id="@+id/rr_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:contentDescription="Rei ou Rainha" />
                    </LinearLayout>
                    <LinearLayout style="@style/WearRow" android:id="@+id/mixed_col">
                        <TextView
                            style="@style/WearText"
                            android:id="@+id/mixed_icon"
                            android:text="⚥"
                            android:layout_width="wrap_content"
                            android:textSize="18sp"
                            android:importantForAccessibility="no" />
                        <Switch
                            android:id="@+id/mixed_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:contentDescription="Duplas mistas" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    style="@style/WearAction"
                    android:id="@+id/btn_replay_cancel"
                    android:text="Fechar"
                    android:backgroundTint="@color/win_red"
                    android:textColor="#100606" />
                <TextView
                    style="@style/WearAction"
                    android:id="@+id/btn_replay_confirm"
                    android:text="Iniciar"
                    android:backgroundTint="@color/start_green"
                    android:textColor="@color/start_green_text" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ScrollView style="@style/WearPage" android:id="@+id/tie_overlay" android:visibility="gone">
        <LinearLayout style="@style/WearColumn">
            <TextView style="@style/WearCaption" android:text="Empate" />
            <LinearLayout style="@style/WearRow">
                <TextView style="@style/WearScore" android:id="@+id/tie_score_l" />
                <TextView style="@style/WearCaption" android:text="–" android:layout_width="wrap_content" />
                <TextView style="@style/WearScore" android:id="@+id/tie_score_r" />
            </LinearLayout>
            <TextView
                style="@style/WearAction"
                android:id="@+id/btn_tie_extend"
                android:text="Prorrogar"
                android:backgroundTint="@color/btn_extend_bg"
                android:textColor="@color/btn_extend_text" />
            <TextView
                style="@style/WearAction"
                android:id="@+id/btn_tie_tiebreak"
                android:text="Tie-break"
                android:backgroundTint="@color/btn_tiebreak_bg"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </ScrollView>
    <ScrollView style="@style/WearPage" android:id="@+id/idle_overlay" android:visibility="visible">
        <LinearLayout style="@style/WearColumn">
            <TextView
                style="@style/WearText"
                android:text="Sem partida"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView style="@style/WearCaption" android:text="Abra o placar no celular" />
        </LinearLayout>
    </ScrollView>
    <ScrollView style="@style/WearPage" android:id="@+id/start_overlay" android:visibility="gone">
        <LinearLayout style="@style/WearColumn">
            <TextView style="@style/WearCaption" android:id="@+id/start_arc_sport" />
            <TextView style="@style/WearText" android:text="1º sacador" android:textStyle="bold" />
            <LinearLayout style="@style/WearColumn" android:id="@+id/start_players" />
            <TextView
                style="@style/WearAction"
                android:id="@+id/btn_start"
                android:text="Iniciar"
                android:backgroundTint="@color/start_green"
                android:textColor="@color/start_green_text" />
        </LinearLayout>
    </ScrollView>
    <ScrollView style="@style/WearPage" android:id="@+id/serve_overlay" android:visibility="gone">
        <LinearLayout style="@style/WearColumn">
            <TextView style="@style/WearCaption" android:id="@+id/serve_arc_sport" />
            <TextView
                style="@style/WearText"
                android:id="@+id/serve_arc_prompt"
                android:text="1º sacador"
                android:textStyle="bold" />
            <LinearLayout style="@style/WearColumn" android:id="@+id/serve_list" />
            <TextView
                style="@style/WearAction"
                android:id="@+id/btn_serve_confirm"
                android:text="Confirmar"
                android:backgroundTint="@color/start_green"
                android:textColor="@color/start_green_text" />
        </LinearLayout>
    </ScrollView>
</app.scoreplace.wear.WatchViewport>
