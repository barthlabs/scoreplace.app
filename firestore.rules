rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    // `authEmail()` REMOVIDA (jul/2026): com a identidade só-uid, nenhuma regra decide
    // permissão por e-mail — a função ficou sem chamador. E-mail é atributo mutável do
    // perfil; identidade é o uid. Ver [[project_uid_primary_identity]].

    // Caller é admin do torneio.
    // SÓ UID (jul/2026, regra do dono: "apenas o uid para identificar os participantes e
    // co-hosts"). Os caminhos por E-MAIL (adminEmails e a recovery via organizerEmail)
    // FORAM REMOVIDOS: e-mail é atributo mutável do perfil, não identidade — a pessoa troca
    // o e-mail e perde/ganha admin sem nada ter mudado no torneio.
    //
    // MIGRAÇÃO FEITA ANTES DE REMOVER (29/jul/2026): varredura dos 8 torneios de produção
    // achou 3 que eram admin SÓ por e-mail (adminUids vazio) — tirar o caminho sem backfill
    // teria trancado 2 organizadores fora dos próprios torneios. `adminUids` foi backfillado
    // (= creatorUid + co-hosts ATIVOS por uid) em todos; conferido: 8/8 convergidos, nenhum
    // torneio sem dono por uid, e as 3 entradas de co-host existentes já tinham uid.
    // `adminEmails` continua sendo GRAVADO como campo derivado (a UI ainda o exibe), mas
    // NÃO decide mais permissão. Ver [[project_cohost_invite_cf_uid_only]].
    function isTournamentAdmin(data) {
      return request.auth != null && (
        // creatorUid — o dono, imutável.
        (data.creatorUid is string && data.creatorUid == request.auth.uid)
        // adminUids — co-hosts ATIVOS por uid (recomputado em todo save).
        || (data.adminUids is list && data.adminUids.size() > 0
            && request.auth.uid in data.adminUids)
      );
    }

    // Keys legitimately touched by the enroll/deenroll transactions when run
    // by a non-admin (i.e. a participant joining or leaving). Anything
    // outside this set requires admin rights.
    function isEnrollmentOnlyDiff() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['participants', 'memberUids', 'status', 'teamOrigins',
          // v2.1.5: inscrição tardia (standby/expand) — um NOVO inscrito que
          // ainda não está em participants escreve a si mesmo na lista de
          // espera. isParticipantBracketDiff exige já-ser-participante, então
          // sem isto a escrita era negada (permission-denied silencioso) e o
          // inscrito via "lista de espera" localmente mas nada persistia.
          'standbyParticipants', 'waitlist',
          // v1.8.40: a transação de FALLBACK do cliente (_enrollParticipantTx) grava
          // `waitlistNoticeSent: true` na inscrição que ATINGE o teto no modo Vagas-por-
          // sorteio (enrollmentLimitMode 'draw'). O campo não estava nesta lista, então
          // SEMPRE que a CF falhava e o torneio estava no teto, a escrita inteira caía
          // com permission-denied — determinístico, e a pessoa não conseguia se inscrever.
          'waitlistNoticeSent']);
    }

    // Participante aceita convite de co-organização (muda seu próprio status
    // de 'pending' para 'active' em coHosts + atualiza adminEmails).
    // Só permitido para quem já é participante do torneio (memberUids).
    // REMOVIDA (jul/2026) — aceitar/recusar convite virou CF (respondHostInvite, Admin SDK).
    // Duas razões: (1) esta regra NUNCA deixou o aceite passar — promover o co-host a
    // 'active' muda `adminUids`, que não estava no hasOnly, e quem aceita ainda não é
    // admin → permission-denied determinístico (Sentry SCOREPLACE-WEB-6R); (2) ela era um
    // caminho de AUTO-PROMOÇÃO: qualquer participante podia escrever coHosts+adminEmails
    // e virar organizador sem convite nenhum — não havia checagem de convite pendente.
    // A CF casa o convite pelo UID de quem chama. Ver functions/cohost-core.js.

    // Participant of the tournament.
    // v1.2.2: UID ONLY. O fallback por memberEmails saiu — participante é quem está em
    // memberUids, e pronto. Ele existia pra torneio legado sem memberUids: não há mais
    // nenhum (todos os docs têm memberUids populado). Fallback num GATE de permissão é o
    // pior lugar pra ter rede de segurança: e-mail é atributo do perfil (a pessoa troca),
    // não identidade. Ver [[project_uid_primary_identity]].
    function isTournamentParticipant(data) {
      return request.auth != null
        && data.memberUids is list
        && request.auth.uid in data.memberUids;
    }
    // REMOVIDA (jul/2026): `isOwnLinkedEmailDiff` era CÓDIGO MORTO — o compile das rules
    // acusava "Unused function". O dono já escreve o próprio perfil pelo `allow update` de
    // users/{userId} (owner pode tudo menos privilegedUserFields), então a função nunca foi
    // chamada. NÃO é buraco: `linkedEmails` é lido como PROVA de posse em mergePhoneAccount
    // (functions/index.js ~4478), mas o único caminho cross-user de escrita em users/{uid}
    // (o antigo isFriendArrayDiff, que permitia escrita cross-user de amizade, MORREU em v2.1.48)
    // — ninguém escreve o linkedEmails de terceiro. A prova atesta o dono, e é o dono que
    // escreve. Ver [[project_privileged_fields_never_client_writable]].

    // v1.8.62: admin por uid (creatorUid) — fallback para organizadores phone-only.
    function isTournamentAdminByUid(data) {
      return request.auth != null
        && data.creatorUid is string
        && data.creatorUid == request.auth.uid;
    }

    // v0.17.24: Diff que participantes podem fazer. Lista positiva expandida
    // após investigação de todos os campos tocados por _advanceWinner,
    // _maybeFinishElimination, _closeRound (Suíço/Liga), auto check-in,
    // logAction, sitOutHistory, etc. — paths que podem rodar como side
    // effect quando participante aprova ou lança placar.
    function isParticipantBracketDiff() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          // Bracket / scoring / aprovação de resultado
          'matches', 'rounds', 'groups', 'rodadas', 'thirdPlaceMatch',
          'currentStage', 'classification', 'standings',
          // Suíço (transição de stage quando última rodada fecha)
          'swissStandings', 'swissRoundsData', 'swissEliminated',
          // Liga / Rei-Rainha
          'sitOutHistory', 'lastAutoDrawAt',
          // Visibilidade do sorteio (set quando rodada fecha)
          'drawVisibility',
          // Check-in / presença / lista de espera em torneio.
          // v1.3.19: checkedInConfirmed = "Confirmado" (azul) — o participante confirma que vem
          // mas NÃO está no local (sem GPS/fora da área). NÃO conta como presente (só o verde
          // checkedIn conta); é um aviso pro organizador. Mesmo allowlist do checkedIn.
          'checkedIn', 'checkedInConfirmed', 'absent', 'tournamentStarted',
          'standbyParticipants', 'waitlist',
          // Activity log (logAction escreve em t.history)
          'history',
          // Timestamps
          'updatedAt', 'lastModified',
          // Liga: toggle ativado/desativado pra próximo sorteio
          'ligaActive', 'ligaInactive',
          // Polls: votação de decisão (cada participante vota uma vez)
          'pollNotifications', 'polls', 'activePollId',
          // Enquete do organizador (📊): inscritos votam gravando opinionPolls[].votes.
          // BUG (Confra): sem este campo na lista, o voto do PARTICIPANTE era
          // rejeitado com permission-denied — só o organizador (admin) conseguia
          // votar. O _save engolia o erro e o toast mentia "voto registrado".
          'opinionPolls',
          // W.O. apontado por participante (wo-claim.js): jogador aponta a falta,
          // o outro lado confirma/contesta. Campo top-level novo que o PARTICIPANTE
          // grava → precisa estar aqui (classe do bug Confra do opinionPolls).
          'woClaims',
          // Categorias notificadas (auto-assign comunica ao participante)
          'categoryNotifications',
          // Flags internas setadas em fim de torneio / transições
          '_finishNotified', '_roundCloseAt',
          // Status — pode mudar pra 'finished' quando última partida aprovada
          'status',
          // Inscrição — overlap com isEnrollmentOnlyDiff
          'participants', 'teamOrigins',
          // v1.8.99: memberUids sempre recomputado em saveTournament
          'memberUids',
          // Convites de dupla pendentes (participante envia/aceita/cancela)
          'pairRequests',
          // v2.7.75: pedidos de vínculo/mescla pendentes — o usuário real aceita
          // (assume a vaga do genérico) ou recusa, alterando pendingMerges.
          'pendingMerges',
          // v2.7.84: nextDrawAt é um índice DERIVADO recomputado em TODO save (cliente
          // e servidor). Qualquer save de participante (placar, convite de dupla, etc.)
          // recalcula esse campo — sem permiti-lo, a regra rejeitava o save inteiro
          // (ex.: convite de dupla do participante não persistia → sem botão de aceite).
          'nextDrawAt'
        ]);
    }

    // ─── Tournaments ─────────────────────────────────────────────────────────
    // discoveryFeed: coleção leve de RESUMO dos torneios públicos, mantida
    // exclusivamente pela Cloud Function `syncDiscoveryFeed` (Admin SDK, que
    // ignora estas rules). Serve só como GATILHO de tempo real + resumo para a
    // descoberta — a fonte de verdade continua sendo `tournaments`. Leitura
    // pública (é descoberta), escrita bloqueada para clientes.
    match /discoveryFeed/{tournamentId} {
      allow read: if true;
      allow write: if false;
    }

    // DEBUG (v1.3.42, TEMPORÁRIO): log do fluxo de sorteio, gravado pelo cliente, pra o
    // desenvolvedor LER direto no Firestore (sem depender de print de tela). Doc por uid.
    // Remover quando o bug do fluxo de sorteio estiver fechado.
    match /debugDrawLogs/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── ⭐ RESUMO DO TORNEIO (25/ago/2026) ────────────────────────────────────
    // Documento LEVE que a tela inicial lê no lugar do torneio inteiro (medido:
    // 343 KB → 28 KB na base real). É DERIVADO: escrito SÓ pela Cloud Function
    // `tournamentSummary`, nunca pelo cliente — por isso `allow write: if false`.
    // A LEITURA espelha exatamente a do torneio: público é legível por todos;
    // privado, só por quem está autenticado; e o SANDBOX do dev só por quem está
    // no memberUids dele (mesma regra do doc completo, senão o resumo vazaria o
    // que o documento esconde). [[project_sandbox_tournament]]
    match /tournaments_summary/{tournamentId} {
      allow read: if (
        (resource.data.get('isSandbox', false) != true
          && ((resource.data.isPublic == true) || (request.auth != null)))
        || (resource.data.get('isSandbox', false) == true
          && request.auth != null
          && (request.auth.uid in resource.data.get('memberUids', [])))
      );
      allow write: if false;   // só a Cloud Function (admin SDK ignora regras)
    }

    /* ── BACKUP CONGELADO: NINGUÉM LÊ, NINGUÉM ESCREVE ─────────────────────────
     * `tournaments_backup/{id}` guarda o documento do torneio INTEIRO como ele era antes
     * de os jogos saírem dele (Fase 2c). Ordem do dono (26/ago): _"precisamos ter aquele
     * backup no sistema antigo inerte"_.
     * ⛔ INERTE quer dizer isto: nem o cliente lê, nem o cliente escreve. Só o Admin SDK
     * (scripts/dividir-jogos.js, scripts/desfazer-divisao.js), que não passa por regra.
     * Sem regra o Firestore já negaria por omissão — está escrito pra ser uma DECISÃO
     * visível e não um esquecimento com o mesmo efeito.
     * ⚠️ E ele carrega o documento cru, que inclui os campos com e-mail que a gente está
     * tirando do doc público. Mais uma razão pra ninguém alcançar.
     * Só o dono manda apagar. */
    match /tournaments_backup/{tournamentId} {
      allow read, write: if false;
    }

    match /tournaments/{tournamentId} {
      // Anonymous users: only public tournaments. Authenticated users may
      // read any tournament (needed for invite links and enroll/deenroll
      // transactions, which have to read before writing). Private
      // tournaments remain hidden from unauth visitors.
      // SANDBOX (project_sandbox_tournament): o torneio de teste do dev NÃO é legível por
      // terceiro NEM por link/id — só quem está no memberUids dele (= o dev). Sem esta
      // linha a invisibilidade era 100% client-side: bastava a regra genérica "authed lê
      // qualquer torneio" pra qualquer um puxar o SB. Fecha o item (3) do isolamento.
      allow read: if (
        (resource.data.get('isSandbox', false) != true
          && ((resource.data.isPublic == true) || (request.auth != null)))
        || (resource.data.get('isSandbox', false) == true
          && request.auth != null
          && (request.auth.uid in resource.data.get('memberUids', [])))
      );

      // Create: quem cria TEM que declarar o próprio uid como creatorUid.
      // SÓ UID (jul/2026). O caminho alternativo por `creatorEmail == authEmail()` foi
      // REMOVIDO: além de identidade por atributo mutável, ele permitia criar um torneio
      // declarando `creatorUid` de OUTRA pessoa (bastava o creatorEmail ser o seu) — doc
      // atribuído a terceiro. Todo torneio em produção já tem creatorUid (varredura de
      // 29/jul: 0 sem dono por uid), e o cliente sempre o grava.
      allow create: if request.auth != null
        && request.resource.data.creatorUid is string
        && request.resource.data.creatorUid == request.auth.uid;

      // Update permitido em 3 caminhos:
      //   1. Admin (creator/co-host ativo) — qualquer mudança. SÓ POR UID
      //      (creatorUid / adminUids); e-mail não decide mais permissão.
      //   2. Qualquer authed pode fazer enrollment-only diff (entrar/sair)
      //   3. Participante pode atualizar campos do bracket (placar, check-in,
      //      aprovação de resultado, voto em poll, etc.) — lista positiva
      //      em isParticipantBracketDiff. Bloqueia mudanças em nome/datas/
      //      formato/regras/organizador/etc. mesmo pra participantes.
      allow update: if request.auth != null
        && (
          isTournamentAdmin(resource.data)
          // v1.8.62: admin por uid (organizador phone-only sem email)
          || isTournamentAdminByUid(resource.data)
          || isEnrollmentOnlyDiff()
          || (isTournamentParticipant(resource.data) && isParticipantBracketDiff())
        );

      // Delete: admins only.
      allow delete: if request.auth != null
        && (isTournamentAdmin(resource.data) || isTournamentAdminByUid(resource.data));

      // ─── Resultado por JOGO em doc próprio (linha 4.1, project_match_result_docs) ───
      // Cada jogo tem seu placar/consenso em tournaments/{id}/results/{matchId}.
      // Escopo PER-JOGO: só os participantes DAQUELE jogo (ou o organizador) escrevem.
      // O subdoc carrega `playerUids` = uids dos dois lados do jogo (definidos por
      // caminho de confiança: o sorteio/avanço, que é admin). O participante do jogo
      // pode gravar o RESULTADO se seu uid está em playerUids E sem alterar playerUids
      // (não pode se auto-incluir). Admin (org/co-host) pode tudo (definir playerUids
      // no sorteio, resolver disputa, refazer). Leitura = quem pode ler o torneio.
      match /results/{matchId} {
        function parentT() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        function isAdminOf(pt) { return isTournamentAdmin(pt) || isTournamentAdminByUid(pt); }
        // `request.auth != null` PRIMEIRO no OR: curto-circuita sem o get() do
        // parentT() → deixa a query collectionGroup de `results` (Fase B: ler os
        // jogos de um uid sem carregar torneio) eficiente. Semântica idêntica à
        // ordem anterior (authed já lia qualquer result subdoc); só evita 1 get()
        // por doc na listagem. Público (sem auth) ainda cai no parentT().isPublic.
        allow read: if (request.auth != null) || (parentT().isPublic == true);
        // Create: só admin (o sorteio cria o doc do jogo já com playerUids).
        allow create: if request.auth != null && isAdminOf(parentT());
        // Update: admin OU participante DAQUELE jogo (uid em playerUids) que NÃO mexe
        // no roster (playerUids imutável pra participante).
        allow update: if request.auth != null && (
          isAdminOf(parentT())
          || ( (resource.data.playerUids is list) && (request.auth.uid in resource.data.playerUids)
               && (request.resource.data.playerUids == resource.data.playerUids) )
        );
        allow delete: if request.auth != null && isAdminOf(parentT());
      }

      // ─── FASE 2 · OS JOGOS FORA DO DOCUMENTO ──────────────────────────────
      // O documento do torneio tem TETO: o Firestore recusa acima de 1 MB, e o Confra já
      // está em 238 KB (os jogos são 101 KB disso). Tirar os jogos do documento é o que
      // remove o teto — e pra isso o cliente precisa PODER LER a subcoleção.
      //
      // ⛔ ISTO NÃO ABRE NADA DE NOVO: `tournaments/{id}/matches` contém EXATAMENTE os
      // mesmos jogos que já estão no documento, e o documento já é legível por este mesmo
      // público. É paridade de leitura, não exposição nova.
      //
      // ⛔ ESCRITA CONTINUA NEGADA AO CLIENTE. Quem escreve aqui é o gatilho
      // `tournamentMirror` (admin SDK, não passa por regra). A escrita pelo cliente é a
      // Fase 2b e exige uma coisa que o documento espelhado AINDA NÃO TEM: `playerUids`
      // no topo, gravado por caminho de confiança (sorteio/avanço) — é ele que permite a
      // regra "só quem joga ESTE jogo escreve, e não pode se auto-incluir", igual à de
      // `results` logo acima. Sem `playerUids`, liberar update aqui seria liberar pra
      // qualquer inscrito mexer em qualquer jogo.
      match /matches/{matchId} {
        function parentTm() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        // ⛔ O CLIENTE NÃO ESCREVE AQUI. NUNCA.
        // Ordem do dono (25/ago/2026): _"o certo é tudo rodar em CF só sendo disparado
        // pelo client side"_ — e é a mesma coisa que ele pediu quando desenhou a
        // arquitetura: _"cada card desenhado de forma leve, puxando as informações que vão
        // nele, com os BOTÕES QUE DISPARAM FUNÇÕES NO SERVIDOR"_.
        //
        // Eu tinha escrito aqui um `allow update` por jogador (espelhando `results`).
        // Funcionava, mas contradiz o princípio: coloca a AUTORIZAÇÃO em dois lugares —
        // nesta regra e no cliente — e regra de segurança é o pior lugar pra manter lógica
        // de negócio (não dá pra testar junto, não dá pra logar, e diverge em silêncio,
        // que foi a causa de três bugs em 25/ago).
        //
        // O caminho de escrita é a Cloud Function: ela confere quem chamou contra
        // `playerUids` do jogo (campo derivado por caminho de confiança), grava com o
        // admin SDK — que não passa por regra — e é a ÚNICA porta. `playerUids` continua
        // sendo gravado: ele deixou de ser insumo DESTA regra e virou insumo da CF.
        allow read: if (request.auth != null) || (parentTm().isPublic == true);
        allow write: if false;
      }

      // ─── FILA DO PLACAR: a intenção espera o sinal, a CF é que aplica ─────
      // O cliente NUNCA mais deriva avanço de chave (ordem do dono: "tudo na cf"). Mas
      // uma CF chamável não tem fila offline e o Firestore tem — numa quadra sem sinal,
      // chamada falha na hora e escrita comum ESPERA e entrega sozinha. Então o cliente
      // grava aqui uma INTENÇÃO ("quero lançar este placar") e o gatilho
      // `applyQueuedResult` aplica no servidor, com a MESMA função da porta chamável.
      //
      // ⛔ `create` SÓ EM NOME PRÓPRIO: `actorUid == request.auth.uid`. Sem isso qualquer
      // inscrito enfileiraria placar se passando por outro — e a CF confia neste campo
      // pra autorizar. É a única coisa que esta regra precisa garantir; TODO o resto
      // (pode lançar este jogo? é a fase certa? o outro time já lançou?) é conferido na
      // CF sobre o doc fresco, que é onde regra de negócio se testa e se loga.
      // ⛔ `update`/`delete` NEGADOS: o item é RECIBO do que a pessoa mandou. Se pudesse
      // ser editado depois de criado, o gatilho leria uma coisa e teria disparado por
      // outra. Quem carimba o desfecho é a CF (admin SDK, não passa por regra).
      // ⭐ O id do documento é derivado da INTENÇÃO pelo cliente: reenviar a mesma
      // intenção cai no mesmo doc e o gatilho roda uma vez só.
      match /resultQueue/{itemId} {
        function parentTq() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.matchId is string
          && request.resource.data.matchId.size() > 0
          && request.resource.data.payload is map
          && (isTournamentParticipant(parentTq()) || isTournamentAdmin(parentTq())
              || isTournamentAdminByUid(parentTq()));
        allow update, delete: if false;
      }

      /* ─── APONTAMENTOS DE CATEGORIA: LEITURA ─────────────────────────────
       * `tournaments/{id}/categoryNotifications/{k}` — o log de "atribuí categoria a
       * fulano". A tela que o lia está DESLIGADA desde 31/jul, mas o dono mandou guardar
       * o registro; o documento fica só com a cauda e o log inteiro vive aqui.
       * ⚠️ Sem regra o Firestore nega por omissão — e o dia em que a tela voltar, ela
       * abriria vazia sem ninguém entender por quê. */
      match /categoryNotifications/{apontamentoId} {
        function parentTc() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        allow read: if request.auth != null;
        allow write: if false;
      }

      /* ─── HISTÓRICO DE ADVERSÁRIOS: LEITURA ──────────────────────────────
       * `tournaments/{id}/opponentHistory/{categoria}` — quem já jogou com quem, usado
       * pelo sorteio pra NÃO repetir dupla. ⚠️ Não é derivado descartável: medido no
       * Confra, 74 dos 215 pares não aparecem mais nos jogos (substituição, W.O., quem
       * saiu). Sem esta regra o Firestore nega por omissão e o sorteio perde o passado.
       * ⛔ Escrita é da CF (o motor de sorteio roda lá), nunca do cliente. */
      match /opponentHistory/{categoria} {
        function parentTo() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        allow read: if (request.auth != null) || (parentTo().isPublic == true);
        allow write: if false;
      }

      /* ─── GRUPOS DIVIDIDOS: LEITURA (2.0.124) ──────────────────────────────
       * `tournaments/{id}/grupos/{k}` é onde o grupo passa a viver quando sai do
       * documento — 22,2 KB no Confra, o maior termo que ainda crescia com gente.
       * Sem esta regra o Firestore nega por omissão e a CHAVE abre sem grupo nenhum.
       * ⛔ Escrita é da CF (admin SDK), nunca do cliente. */
      match /grupos/{grupoId} {
        function parentTg() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        allow read: if (request.auth != null) || (parentTg().isPublic == true);
        allow write: if false;
      }

      /* ─── PRESENÇA E RASTRO DE W.O. DIVIDIDOS: LEITURA (2.0.123) ────────────
       * Mesmos termos das outras partes: o cliente LÊ, e só a CF escreve (admin SDK
       * passa por cima das regras). Sem a regra o Firestore nega por omissão e a tela
       * abre sem presença — o mesmo modo de falhar que o elenco teve.
       * ⛔ `allow write: if false` NÃO é excesso de zelo: a porta de escrita é
       * `aplicarNoTorneio`, que confere quem pode mexer em quê. Deixar o cliente
       * escrever aqui seria contornar a tabela de permissão inteira.
       * [[project_porta_unica_de_escrita_cf]] */
      match /checkedIn/{quemId} {
        function parentTp() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        allow read: if (request.auth != null) || (parentTp().isPublic == true);
        allow write: if false;
      }
      match /woClaims/{claimId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
      match /woLog/{logId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      /* ─── INSCRITOS DIVIDIDOS: LEITURA ────────────────────────────────────
       * `tournaments/{id}/inscritos/{k}` é onde o elenco passa a viver quando sai do
       * documento. ⛔ E o nome NÃO é `participants` de propósito: essa já tem dono — o
       * espelho de roster (id = uid, dado cru), de antes desta arquitetura. Dividir pra lá
       * botou dois esquemas no mesmo lugar e deu 13 documentos onde deviam ser 8.
       * Sem esta regra o Firestore nega por omissão e o torneio abre SEM ELENCO.
       * ⛔ Escrita é da CF (admin SDK), nunca do cliente. */
      match /inscritos/{inscritoId} {
        function parentTi() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        allow read: if (request.auth != null) || (parentTi().isPublic == true);
        allow write: if false;
      }

      // ─── HISTÓRICO ESPELHADO: LEITURA, PRA AGUENTAR A PODA ────────────────
      // `tournaments/{id}/history/{k}` é onde o log de auditoria vive INTEIRO. O
      // documento do torneio tem teto de 1 MB e o histórico é o único campo que cresce
      // PRA SEMPRE (medido 26/ago: 37 KB dos 245 KB do Confra) — a cauda dele vai ser
      // podada do documento, e é daqui que a tela busca o que foi podado.
      // ⛔ Sem esta regra a leitura é NEGADA POR OMISSÃO, e podar faria o log sumir da
      // tela em silêncio — que é justamente o que não pode acontecer com um rastro de
      // auditoria (reconstruir o sumiço do Gersom custou uma tarde por falta dele).
      // Mesma paridade do documento pai: quem vê o torneio vê o log dele.
      // ⛔ Escrita é da CF (gatilho `tournamentMirror`, admin SDK), nunca do cliente —
      // mesmo princípio de `matches` logo acima.
      match /history/{eventoId} {
        function parentTh() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        allow read: if (request.auth != null) || (parentTh().isPublic == true);
        allow write: if false;
      }

      // ─── Busca ativa letzplay do organizador (anti-gato) ───────────────────
      // tournaments/{id}/letzplayScans/{uid} — o organizador varre o PERFIL
      // PÚBLICO letzplay dos inscritos que autorizaram (categoria/nível) via a
      // extensão. Só o admin (org/co-host) escreve; qualquer authed que pode ler
      // o torneio lê (co-organizadores veem o mesmo).
      match /letzplayScans/{scanUid} {
        function parentTs() {
          return get(/databases/$(database)/documents/tournaments/$(tournamentId)).data;
        }
        allow read: if (request.auth != null) || (parentTs().isPublic == true);
        allow create, update: if request.auth != null
          && (isTournamentAdmin(parentTs()) || isTournamentAdminByUid(parentTs()));
        allow delete: if request.auth != null
          && (isTournamentAdmin(parentTs()) || isTournamentAdminByUid(parentTs()));
      }
    }

    // ─── Placares por COLLECTION GROUP ────────────────────────────────────────
    // `tournaments/{id}/results/{matchId}` é o lugar onde o placar vive. Pra ler os jogos
    // de UMA PESSOA sem carregar torneio nenhum, a consulta é
    // `collectionGroup('results').where('playerUids','array-contains', uid)`.
    //
    // ⚠️ REGRA ANINHADA NÃO VALE PRA COLLECTION GROUP. A permissão declarada dentro de
    // `match /tournaments/{tournamentId}/...` só se aplica àquele caminho; uma consulta de
    // collection group é avaliada contra `match /{path=**}/results/{matchId}` e mais nada.
    // Sem esta regra a consulta voltava permission-denied SEMPRE — e a ficha de quem jogou
    // aqui aparecia com "Torneios 0 · Rankings 0 · Jogos 0", como se a pessoa nunca tivesse
    // jogado. Medido em 01/ago/2026 no perfil da Flávia Barchetta.
    // Leitura só; escrita continua exclusivamente pelo caminho aninhado, que valida o
    // torneio pai.
    match /{path=**}/results/{matchId} {
      allow read: if request.auth != null;
    }

    // ─── Histórico letzplay: 1 doc por COMPETIÇÃO, 1 doc por PARTIDA ──────────
    // letzplayTournaments/{compId}/matches/{gid} — mesmo molde dos nossos jogos
    // (tournaments/{id}/results/{matchId}), que é como o letzplay também organiza.
    //
    // POR QUE NÃO É UM DOC POR USUÁRIO: uma partida do letzplay tem 4 pessoas, então ela
    // é importada até 4 vezes (uma por perspectiva). Como doc compartilhado, o mesmo jogo
    // vira UM doc (o gid é neutro de perspectiva — ver js/letzplay-model.js) e importar
    // uma pessoa já preenche o pedaço dos parceiros/adversários. Como doc por usuário,
    // seria o mesmo jogo repetido 4x, com o placar invertido em metade das cópias.
    //
    // Dado é PÚBLICO no letzplay (qualquer um lê o perfil de qualquer um sem login), então
    // leitura/escrita por qualquer authed — mesma política de letzplayScans. A whitelist
    // de chaves é o que impede um cliente de pendurar campo arbitrário.
    //
    // A leitura do histórico de alguém é collectionGroup('matches') com
    // where('players','array-contains', handle) — o mesmo padrão que `results` usa pra ler
    // os jogos de um uid sem carregar o torneio. Por isso `allow read` NÃO faz get() no
    // pai: um get() por doc tornaria a listagem cara.
    match /letzplayTournaments/{compId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['compId', 'club', 'kind', 'letzId', 'name', 'categoryRaw', 'sport', 'standings', 'logo', 'updatedAt', 'seenFrom']);
      allow delete: if false;   // histórico é acervo: ninguém apaga pelo cliente

      match /matches/{gid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.keys().hasOnly(['gid', 'comp', 'club', 'kind', 'sport', 'date', 'dateNum', 'round', 'teams', 'winner', 'players', 'updatedAt', 'seenFrom']);
        allow delete: if false;
      }
    }

    // ─── Scan público letzplay POR PESSOA (uid), global e reutilizável ─────────
    // letzplayScans/{uid} — o organizador busca o PERFIL PÚBLICO letzplay do inscrito
    // (categoria/nível/totais) via extensão e grava aqui, keyed por uid. Puxou uma vez,
    // vale pra TODOS os torneios (não precisa re-puxar). Dado é público no letzplay.
    // Leitura: qualquer authed. Escrita: qualquer authed (organizador) — dado público.
    match /letzplayScans/{scanUid} {
      allow read: if request.auth != null;
      // scannedByName + tournamentId/Name identificam quem/qual torneio puxou; fullImport
      // é o histórico COMPLETO (só no scan "completo") que vira o letzplayImport do dono.
      //
      // `lzCursorParcial` e `totaisLetzplay` entraram na 1.6.64, quando o PARCIAL deixou de
      // gravar histórico e passou a gravar só PROGRESSO (onde parou) e ESTRUTURA (quantos
      // torneios/rankings/jogos existem). Eu subi o código e esqueci a whitelist: toda
      // escrita virou permission-denied e a leitura "avançava" na tela sem gravar nada.
      // Campo novo no cliente sem campo novo aqui = escrita rejeitada, sempre.
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['handle', 'scan', 'scannedAt', 'scannedBy', 'scannedByName', 'tournamentId', 'tournamentName', 'fullImport', 'lzCursorParcial', 'totaisLetzplay']);
      allow delete: if request.auth != null;
    }

    // ─── User profiles ───────────────────────────────────────────────────────
    // Diff that only touches the friend-relationship arrays. Used to let a
    // caller modify another user's friends / friendRequestsReceived /
    // friendRequestsSent arrays WITHOUT being able to touch profile fields.
    // The sendFriendRequest / accept / reject / cancel flows need this because
    // each one updates the OTHER party's arrays.
    // ⛔ REMOVIDA em 29/ago/2026 (v2.1.48) — `isFriendArrayDiff()` era a porta de uma
    // ESCALADA DE PRIVILÉGIO. Ela perguntava só "quais chaves mudaram?" e nunca "quem
    // está mudando?", então QUALQUER autenticado escrevia `friends` no perfil de QUALQUER
    // pessoa; como `statsVisibleToCaller` decidia leitura por `uid in friends`, bastava
    // isso pra ler estatísticas marcadas como "só amigos". Três linhas no console.
    // Mesma classe do sequestro por `mergedInto` (abaixo): campo que o servidor trata
    // como PROVA não se deixa na mão de quem ele avalia.
    // A amizade agora vive em `friendships/{pairId}` e a prova em
    // `friendAccess/{uid}/accepted/{friendUid}`, ambas escritas SÓ pelo Admin SDK
    // (functions/index.js → sendFriendRequest/accept/reject/cancel/removeFriend).

    // v1.7.51 — o DONO das estatísticas decide quem as vê (`statsVisibility` no perfil).
    // Um `get()` só, guardado em `u`: o dialeto (rules_version 2) cacheia chamadas
    // repetidas ao mesmo caminho dentro da mesma avaliação, mas ler uma vez deixa a
    // intenção óbvia e não flerta com o teto de acessos por requisição.
    // `.get(campo, default)` é o mesmo padrão já usado no isSandbox dos torneios.
    // AUSENTE = 'public' — o default das contas que existiam antes desta regra.
    function statsVisibleToCaller(userId) {
      let u = get(/databases/$(database)/documents/users/$(userId)).data;
      let vis = u.get('statsVisibility', 'public');
      // ⭐ A prova de amizade é a PROJEÇÃO server-only, nunca mais o array do perfil.
      // `exists()` num caminho dirigido não precisa ordenar os uids (as Rules não sabem
      // montar o `pairId`), e responde sem ramificação.
      return vis == 'public'
        || (vis == 'friends'
            && exists(/databases/$(database)/documents/friendAccess/$(userId)/accepted/$(request.auth.uid)));
    }

    match /users/{userId} {
      // Authenticated only — strips PII (email, phone, preferredCeps,
      // fcmToken, etc.) from anonymous visitors. Needed for friend search
      // (searchUsers range query) and participant detail views.
      allow read: if request.auth != null;

      // v1.2.9 — CAMPOS PRIVILEGIADOS: só o Admin SDK (Cloud Functions) escreve.
      //
      // SEQUESTRO DE CONTA (achado e provado no emulador em 15/jul/2026): o `allow update`
      // dizia "owner may touch anything" e só se preocupava com edição CROSS-user. Mas
      // `mergedInto` é lido pela CF resolveMergedLogin, que devolve um CUSTOM TOKEN do uid
      // apontado. Então bastava a pessoa escrever no PRÓPRIO perfil
      //     users/{meu-uid} = { mergedInto: "<uid-da-vítima>" }
      // e chamar resolveMergedLogin pra entrar na conta de qualquer um. Um campo que o
      // servidor TRATA COMO PROVA nunca pode ser escrito por quem ele autoriza.
      //
      // Bloquear não quebra nada: nenhum caminho do cliente escreve estes campos (0 writes
      // no js/ — só leituras), e o Admin SDK ignora rules por definição.
      //   mergedInto/mergedAt → prova de merge (resolveMergedLogin dá custom token)
      //   plan/planExpiresAt  → assinatura Pro (só o webhook do Stripe pode conceder)
      //   dupDismissed        → v1.7.44. Memória do "não sou eu": suprime a pergunta de
      //     conta duplicada. Escrito só por dismissDuplicateSuspicion, que grava nos DOIS
      //     perfis DEPOIS de redescobrir o par no servidor. Forjá-lo não dá acesso a nada
      //     (só cala um aviso sobre si mesmo), mas é decisão do SERVIDOR sobre identidade —
      //     e o histórico aqui é claro: campo que o servidor consulta pra decidir não se
      //     deixa na mão de quem ele avalia.
      //   dupDismissedInfo    → v1.8.3. O MESMO "não sou eu", agora com a FORÇA do sinal
      //     que foi dispensado — é ela que decide se uma evidência nova (ex.: o mesmo
      //     celular) reabre a pergunta que a pessoa já recusou. Escrevível pelo cliente,
      //     bastaria gravar força máxima uma vez pra nunca mais ser perguntado, o que é
      //     pior que o array antigo: silenciaria até a evidência forte.
      //   dupSuspect          → v1.8.3. Sinal de POSSÍVEL SEGUNDA CONTA gravado pelo
      //     trigger no cadastro (só o contato MASCARADO). Escrevível pelo cliente, dá pra
      //     apagá-lo pra nunca ser perguntado — e pra plantar um aviso falso com contato
      //     inventado na tela de outra pessoa.
      //   nameConflict        → v1.7.44. Sinal gravado pelo trigger enforceUniqueDisplayName
      //     quando o nome colide. É o que faz a pergunta aparecer; escrevível pelo cliente,
      //     vira um jeito de nunca ser perguntado — e de plantar um aviso falso com
      //     contato inventado na tela de outra pessoa se um dia virar leitura cruzada.
      // Bloquear os dois é grátis: ZERO caminho do cliente os escreve (conferido em js/ —
      // 12 menções, todas de leitura), e o Admin SDK ignora rules por definição.
      //   phoneSource/phoneSetBy/phoneSetAt → v1.9.97. PROCEDÊNCIA do celular. É o que o
      //     servidor consulta pra decidir se um telefone vale como IDENTIDADE (recuperação
      //     de senha, dedup, fusão) ou só como CONTATO (isIdentityPhone, em
      //     functions/contact-phone-core.js). Escrevível pelo cliente, bastaria APAGAR
      //     `phoneSource` pra promover a identidade um número que a pessoa nunca confirmou
      //     por SMS — e um número desses pode ser de terceiro (erro de digitação de quem
      //     registrou). Campo que o servidor TRATA COMO PROVA não se deixa na mão de quem
      //     ele avalia — a mesma lição de `mergedInto` acima.
      //     Bloquear é grátis: quem escreve é só a CF setParticipantContactPhone (Admin
      //     SDK), e nenhum caminho do cliente os toca.
      function privilegedUserFields() {
        return ['mergedInto', 'mergedAt', 'plan', 'planExpiresAt', 'dupDismissed', 'dupDismissedInfo', 'dupSuspect', 'nameConflict',
                'phoneSource', 'phoneSetBy', 'phoneSetAt',
                // v2.1.48 — os três arrays de amizade viraram CACHE DE EXIBIÇÃO. A relação
                // mora em `friendships/{pairId}` e a prova em `friendAccess/**`. Nem o dono
                // do próprio perfil escreve mais por cliente: quem escrevesse o próprio
                // `friends` fabricaria a metade dele da relação, e a projeção (que é o que
                // as Rules leem) ficaria mentindo sobre a outra metade.
                'friends', 'friendRequestsSent', 'friendRequestsReceived', 'friendRequestsSentAt'];
      }
      function touchesPrivileged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(privilegedUserFields());
      }

      // Create: only the user themselves (first-time profile creation).
      // O bloqueio precisa valer no CREATE também — senão o buraco reabre: apagar o próprio
      // perfil e recriá-lo já com `mergedInto` seria o mesmo sequestro por outro caminho.
      allow create: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(privilegedUserFields());

      // Update: SÓ o dono, e nunca os campos privilegiados. O caminho cross-user que
      // existia aqui pra amizade morreu em 29/ago/2026 — ver isFriendArrayDiff acima.
      allow update: if request.auth != null
        && request.auth.uid == userId && !touchesPrivileged();

      // Delete: owner only.
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Notifications — senders create (cross-user), owner manages.
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Match history (stats across tournaments + casual matches).
      //
      // v1.7.51 — QUEM LÊ passou a ser ESCOLHA DA PESSOA (`statsVisibility` no perfil:
      // 'public' | 'friends' | 'private'). Antes era só o dono, e isso tinha um efeito
      // que ninguém via: a ficha de OUTRO jogador (classificação e Análise de Inscritos)
      // lê exatamente esta subcoleção, levava permission-denied, o cliente engolia o erro
      // e desenhava a grade de estatísticas ZERADA — recusa e "nunca jogou" ficavam
      // visualmente idênticas. Ver [[project_stats_visibility_user_choice]].
      //
      // AUSENTE = 'public' (decisão do dono, 06/ago/2026): as 185 contas que já existem
      // continuam com a ficha funcionando. Não abre nada novo — `matchHistory` é cópia
      // desnormalizada do que JÁ é legível: `{path=**}/results` (qualquer autenticado) e
      // `casualMatches` (leitura livre). Quem quiser fechar, fecha no perfil.
      //
      // ESCRITA continua SÓ do dono — visibilidade muda quem LÊ, nunca quem grava.
      match /matchHistory/{matchId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId || statsVisibleToCaller(userId)
        );
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Templates — only owner.
      match /templates/{templateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // v1.9.97 — CAMADA 2 do celular: rastro das tentativas de verificação por SMS.
      //
      // Nasceu do caso da Leila (20/ago/2026): o SMS foi disparado, o Google devolveu
      // 200, e ninguém — nem ela, nem o organizador, nem o sistema — soube que não
      // chegou. A resposta pra "quem tentou e não conseguiu?" só existia na métrica do
      // Cloud Monitoring, o que na prática é não existir.
      //
      // Só o DONO escreve e lê o próprio rastro. Quem consolida pro organizador é a CF
      // nudgeMissingPhones, que usa Admin SDK e ignora rules por definição. Forjar aqui
      // não dá acesso a nada: o campo não é prova de posse de telefone (a prova é o
      // idToken do SMS), só decide QUAL texto de cobrança a pessoa recebe.
      match /phoneVerifyAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Trophies + milestones — MESMA regra do matchHistory (v1.7.51): quem lê é a
      // escolha da pessoa (`statsVisibility`). Um campo só governa os dois porque é a
      // mesma pergunta — "quem vê meu desempenho" — e dois interruptores para a mesma
      // coisa viram dois estados pra explicar.
      //
      // Tinha o MESMO defeito do matchHistory, e escondido do mesmo jeito: a ficha
      // compara troféus com o amigo (`_loadUserTrophies(playerUid)`), a regra negava,
      // o cliente engolia com `.catch` e devolvia `{}` — então **o amigo aparecia
      // sempre com ZERO troféus**. Recusa desenhada como ausência.
      //
      // ESCRITA segue só do dono (o backfill usa Admin SDK e passa por fora das regras).
      match /trophies/{trophyId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId || statsVisibleToCaller(userId)
        );
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /milestones/{milestoneId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId || statsVisibleToCaller(userId)
        );
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Verificação de e-mail secundário — SERVER-ONLY (L1.1, 2.1.65) ───────
    // ⛔ O QUE ESTAVA AQUI ERA UM BURACO, não um descuido de digitação:
    //     allow read: if true;    // "token é o segredo — quem tem o link pode ler"
    //     allow create: if request.auth != null;
    //     allow update: if true;  // marcar verified=true após clique no link
    // O token era o ID do documento e ia CRU pro banco, então `read: true` permitia LISTAR a
    // coleção e colher tokens VÁLIDOS de terceiros — o token só é segredo se ninguém mais
    // puder lê-lo. E `update: true` deixava qualquer um, inclusive anônimo, marcar
    // `verified`. Somando: o token nascia no cliente com `Math.random()`.
    //
    // ⚠️ E isto não era "só" um e-mail a mais no perfil: `linkedEmails` é PROVA DE POSSE —
    // `functions/index.js` aceita `via: "email-vinculado"` como prova numa fusão de contas, e
    // `_uidByProfileEmail` resolve LOGIN por ele. Quem escrevesse aqui mexia em quem entra na
    // conta. Ver [[project_privileged_fields_never_client_writable]].
    //
    // Agora quem cria, lê e consome é o Admin SDK, pelas capabilities
    // `requestSecondaryEmail` / `confirmSecondaryEmail`. O documento é chaveado pelo HASH do
    // token; o token só existe no e-mail enviado.
    match /emailVerifications/{token} {
      allow read, write: if false;
    }

    // Freio de reenvio do e-mail secundário (chave = hash de uid+e-mail). Só Admin SDK.
    match /emailVerifyThrottle/{chave} {
      allow read, write: if false;
    }

    // ─── Casual matches ──────────────────────────────────────────────────────
    // Public read so anonymous QR / room-code joins work — no PII. Writes
    // require auth; the claim-slot transaction adds uid to playerUids, so
    // we can't scope update to "already-in-playerUids" without breaking the
    // join flow. Left permissive for authenticated users.
    match /casualMatches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Placares AO VIVO (vitrine "Ao vivo agora") ──────────────────────────
    // LEITURA ABERTA de propósito: a regra do dono é "qualquer um pode clicar e ver".
    // O doc não guarda nada além do que já está na tela de quem assiste — nomes em
    // quadra, placar e o ponto a ponto da partida.
    // ESCRITA: só autenticado, e só quem ABRIU o placar continua escrevendo nele —
    // sem isso, um espectador poderia sobrescrever o placar de quem está em quadra
    // (que é justamente o que o modo espectador promete que não acontece).
    match /liveScores/{liveId} {
      // Leitura casada com a PLATEIA do doc (1.9.37): `'*'` = qualquer um (torneio
      // público e casual); torneio PRIVADO lista os uids de quem está nele. A consulta
      // do cliente pede exatamente isto (`audience array-contains-any ['*', meu uid]`) —
      // em Firestore a regra não filtra, então consulta e regra têm que dizer a MESMA
      // coisa, senão a lista inteira falha. Docs antigos (sem `audience`) seguem
      // legíveis: a vitrine nasceu pública e ninguém fica preso a um doc invisível.
      allow read: if !('audience' in resource.data)
        || '*' in resource.data.audience
        || (request.auth != null && request.auth.uid in resource.data.audience);
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // ─── Friend requests ─────────────────────────────────────────────────────
    // ─── AMIZADE: a autoridade (v2.1.48) ─────────────────────────────────────
    // `friendships/{pairId}` é a RELAÇÃO canônica; `friendAccess/{uid}/accepted/{fid}`
    // é a projeção que `statsVisibleToCaller` consulta. As duas são escritas SÓ pelo
    // Admin SDK (functions/index.js). Cliente lê o que é dele e não escreve NADA —
    // se escrevesse, a escalada que isto veio fechar reabria por outra porta.
    /* ⛔ COORDENAÇÃO DE CICLO DE VIDA (v2.1.48) — só o Admin SDK escreve.
     * `userLifecycle/{uid}.estado` é lido DENTRO da transação de amizade e é o que faz um
     * merge/exclusão concorrente forçar retry e recusa. Se o cliente pudesse escrever, ele
     * destrancaria a própria conta no meio de uma fusão — que é exatamente a corrida que
     * este documento fecha. Leitura liberada pro dono só pra a UI poder explicar a espera. */
    match /userLifecycle/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /friendships/{pairId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.uidA || request.auth.uid == resource.data.uidB);
      allow write: if false;
    }
    match /friendAccess/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      match /accepted/{friendUid} {
        allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
        allow write: if false;
      }
    }

    /* ⛔ FECHADA em 29/ago/2026 (v2.1.48, 4ª auditoria, ponto 8).
     * Era `allow read, write: if request.auth != null`, com um TODO(security) aberto —
     * qualquer autenticado lia e escrevia convite de qualquer pessoa.
     * AUDITADO ANTES DE FECHAR: zero consumidores em js/, functions/, functions-autodraw/,
     * extension/, scripts/ e index.html (o que sobra de "friendRequests" no código são os
     * CAMPOS `friendRequestsSent`/`Received`/`SentAt`, que são outra coisa), zero índices
     * em firestore.indexes.json, e **0 documentos em produção** — conferido em 29/ago/2026
     * contra o projeto scoreplace-app.
     * O convite agora vive em `friendships/{pairId}` com status `pending`. */
    match /friendRequests/{requestId} {
      allow read, write: if false;
    }

    // ─── Reports (moderação de UGC — Apple Guideline 1.2) ────────────────────
    // Usuários autenticados criam denúncias de conteúdo (avaliações de locais,
    // etc.). Write-only: a equipe revisa via console/Admin SDK. Ninguém lê,
    // edita ou apaga pelo cliente (evita retaliação/adulteração).
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ─── Login redirects (v1.2.9) — PROVA, escrita só pelo Admin SDK ─────────
    // Quando duas contas do MESMO tipo são fundidas (duas Google, p.ex.), a credencial da
    // absorvida não migra — o Firebase não põe dois provedores do mesmo tipo numa conta, e a
    // conta dela é apagada. Quem loga com aquele e-mail cai numa conta nova e VAZIA. O merge
    // grava aqui `{email|telefone} → ownerUid` e a CF resolveLoginRedirect manda a pessoa pra
    // conta certa via custom token.
    //
    // deny-all TOTAL: este doc concede acesso a uma conta, então é prova. Se o cliente
    // pudesse escrever, bastaria reivindicar o e-mail de outro pra capturar o login dele —
    // que é exatamente por que o redirect NÃO usa `linkedEmails`/`email` do perfil (o cliente
    // escreve esses). A leitura também é fechada: o mapa e-mail→uid é PII.
    // Ver [[project_privileged_fields_never_client_writable]].
    match /loginRedirects/{key} {
      allow read, write: if false;
    }

    // ─── Mail (firestore-send-email extension) — SERVER-ONLY (L1.2) ──────────
    // ⛔ ERA `allow write: if request.auth != null`, e isso não era "fila de e-mail":
    // era um RELAY. Quem estivesse logado escolhia DESTINATÁRIO, ASSUNTO e HTML, e a
    // extensão entregava saindo do remetente do produto. O inventário da L1.P0 mediu a
    // superfície: uma única porta cliente (`FirestoreDB.queueEmail`) e três fluxos
    // usando-a — convite de torneio, convite de dupla e convite de co-organização.
    //
    // ⭐ A ORDEM IMPORTOU. Fechar a regra ANTES de migrar teria quebrado os três fluxos
    // em produção. As levas foram: L1.3a (convite avulso → `sendTournamentInvite`),
    // L1.1 (dupla e co-organização → `sendPairInviteEmail`/`sendCoHostInviteEmail`, e
    // `queueEmail` deixou de existir), L1.1.1 (o e-mail só é pedido depois de o convite
    // PERSISTIR — senão a Function lia o documento antes do registro e recusava). Só
    // então, com a varredura de `js/` sem nenhum writer, a porta fecha.
    //
    // ⚠️ AS FUNCTIONS NÃO PASSAM POR AQUI: elas usam o Admin SDK, que ignora as rules.
    // Fechar a regra não desliga nenhum e-mail legítimo — e a extensão
    // firestore-send-email continua consumindo a coleção normalmente.
    //
    // ⛔ SEM EXCEÇÃO POR UID, E-MAIL, DONO DE TORNEIO OU CAMPO DO PAYLOAD. Qualquer
    // brecha desse tipo devolve o relay por outro nome: o que o cliente controla, ele
    // escolhe. Travado por tests/rules-mail-server-only.test.js, contra o emulador.
    // ⚠️ `notif_email_queue` (logo abaixo) NÃO é escopo desta leva — segue aberta a
    // autenticado e é dívida registrada como L2.
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // ─── Notif email digest queue (v2.1.19) ──────────────────────────────────
    // E-mails de NOTIFICAÇÃO entram aqui (janela por importância 5/15/30 min) e
    // a Cloud Function flushNotifEmailDigest consolida num e-mail por pessoa.
    // Qualquer autenticado enfileira (mesmo modelo do mail/); leitura/exclusão
    // só pela função (Admin SDK ignora rules).
    match /notif_email_queue/{id} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // v1.2.9: as regras de whatsapp_queue / whatsapp_digest_queue / whatsapp_round_queue
    // saíram junto com a integração (número banido, apelação negada, portfólio Meta
    // morto). Sem regra, o default-deny cobre: se algum código velho tentar enfileirar,
    // a escrita é NEGADA — que é o certo, já que não há quem consuma a fila.
    // Ver project_whatsapp_meta_2fa_block.

    // ─── Email verification codes (v3.0.x) — SERVER-ONLY ──────────────────────
    // sendVerificationCode/verifyEmailCode (Cloud Functions, Admin SDK) gravam e leem o
    // código de confirmação HASHEADO. O cliente NUNCA acessa — senão poderia ler o hash
    // ou forjar a verificação. O default-deny já cobriria; explicitamos pra deixar claro.
    match /emailVerifyCodes/{uid} {
      allow read, write: if false;
    }

    // ─── Magic Links wrapper (v1.0.30-beta) ──────────────────────────────────
    // Cloud Function `sendMagicLink` cria docs aqui com o link Firebase
    // assinado. Usuário NÃO autenticado clica no email, abre /?ml=TOKEN no
    // browser, e o JS do app lê esse doc pra resolver o firebaseLink real e
    // redirecionar. Token é 24 chars random base64url — segredo suficiente
    // pra leitura pública (igual unlisted YouTube link). Escrita só via
    // Admin SDK (Cloud Function bypassa rules).
    match /magicLinks/{token} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Presences (check-ins + planned "I'll play here") ─────────────────────
    // Any authenticated user may read; client filters by visibility and friends.
    // Create: must match caller's uid. Update/delete: owner only.
    // TODO(security): lock reads to friends + public via a denormalized
    // friendUids[] once the feature is validated.
    match /presences/{presenceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // ─── Venues (community listings, opcionalmente reivindicáveis) ───────────
    // Qualquer usuário autenticado pode cadastrar um local novo; o dono
    // formal (ownerUid) é uma reivindicação opcional. Leitura pública para
    // descoberta anônima.
    //
    // Create:
    //   - authed, createdByUid == auth.uid
    //   - ownerUid pode ser null (cadastro comunitário) ou == auth.uid
    //     (reivindicação na criação).
    // Update:
    //   - dono formal (ownerUid == auth.uid) pode alterar tudo
    //   - se não há dono, qualquer authed pode alterar desde que não promova
    //     outra pessoa a dono (ownerUid deve permanecer null ou virar self)
    //   - qualquer authed pode incrementar viewCount/lastViewedAt
    // Delete: dono formal (ownerUid == auth.uid).
    function isViewCountBump() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['viewCount', 'lastViewedAt']);
    }
    function venueOwnershipOk() {
      return request.resource.data.ownerUid == null
        || request.resource.data.ownerUid == request.auth.uid;
    }
    // Foto do local, baixada do Google UMA VEZ e servida daqui (v1.7.53). Leitura pública
    // porque é o fundo dos cards, que aparecem antes do login. ESCRITA NEGADA A TODO
    // CLIENTE de propósito: só a CF cacheVenuePhoto (Admin SDK) grava. Foi um bug de
    // render que gerou 89.927 chamadas pagas ao Places em 30 dias para 2 fotos — com a
    // escrita fechada, nenhuma versão do cliente (inclusive a nativa publicada, que não
    // tem auto-update) consegue repetir isso.
    match /venuePhotos/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    match /venues/{venueId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.createdByUid == request.auth.uid
        && venueOwnershipOk();
      allow update: if request.auth != null
        && (
          resource.data.ownerUid == request.auth.uid
          || isViewCountBump()
          || (resource.data.ownerUid == null && venueOwnershipOk())
        );
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // Avaliações do local: estrelas (1-5) + texto opcional. Um review por
      // usuário (doc id = uid). Leitura pública para busca anônima. Criar e
      // atualizar só quem é o próprio autor; dono do venue pode moderar.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && reviewId == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid;
        // Delete: próprio autor OU dono do venue (moderação).
        allow delete: if request.auth != null
          && (
            resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/venues/$(venueId)).data.ownerUid == request.auth.uid
          );
      }

      // Quadras do local:
      //
      // DUAS FASES:
      // 1. FASE COLABORATIVA (venue sem owner): qualquer autenticado adiciona;
      //    cada contribuidor pode editar/apagar APENAS suas próprias entradas.
      // 2. FASE CLAIMED (venue com ownerUid): o dono é o único que adiciona,
      //    edita e apaga quadras. Quando um usuário reivindica o local, ele
      //    "assume tudo" — inclusive as entradas cadastradas pela comunidade
      //    ficam sob sua gestão exclusiva. Contributors originais perdem
      //    acesso de edição (a entrada permanece, mas gerenciada pelo dono).
      //
      // CREATE: permitido se (a) venue não tem dono E o criador é o
      //   contributor, OU (b) venue tem dono e esse dono é o criador.
      // UPDATE/DELETE: mesmo princípio — contributor só quando não há dono;
      //   dono sempre quando existe.
      match /courts/{courtId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.contributorUid == request.auth.uid
          && request.resource.data.sport is string
          && request.resource.data.count is int
          && request.resource.data.count >= 1
          && request.resource.data.count <= 999
          && (
            // Venue sem dono: qualquer autenticado contribui
            !('ownerUid' in get(/databases/$(database)/documents/venues/$(venueId)).data)
            || get(/databases/$(database)/documents/venues/$(venueId)).data.ownerUid == null
            // OU: venue tem dono e o criador É o dono
            || get(/databases/$(database)/documents/venues/$(venueId)).data.ownerUid == request.auth.uid
          );
        allow update: if request.auth != null
          && (
            // Venue tem dono: só o dono edita (assume tudo, incluindo
            // entradas que foram feitas por contribuidores antes)
            get(/databases/$(database)/documents/venues/$(venueId)).data.ownerUid == request.auth.uid
            // OU: venue sem dono e usuário é o contributor original
            || (
              (
                !('ownerUid' in get(/databases/$(database)/documents/venues/$(venueId)).data)
                || get(/databases/$(database)/documents/venues/$(venueId)).data.ownerUid == null
              )
              && resource.data.contributorUid == request.auth.uid
            )
          );
        allow delete: if request.auth != null
          && (
            get(/databases/$(database)/documents/venues/$(venueId)).data.ownerUid == request.auth.uid
            || (
              (
                !('ownerUid' in get(/databases/$(database)/documents/venues/$(venueId)).data)
                || get(/databases/$(database)/documents/venues/$(venueId)).data.ownerUid == null
              )
              && resource.data.contributorUid == request.auth.uid
            )
          );
      }
    }
  }
}
