rules_version = '2';
// ⛔ SÓ PARA O EMULADOR do teste `test-reconciliacao-marca-emu.js` deste codebase.
// O Admin SDK ignora Rules; esta liberação existe porque o emulador de Firestore exige um
// arquivo de rules DENTRO do diretório do projeto, e a config daqui não pode apontar para
// fora dele. ⛔ NUNCA é publicada: as Rules de produção são as da raiz (`firestore.rules`).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if true; }
  }
}
